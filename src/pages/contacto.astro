---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import { contactInfo, telHref } from "../data/contactInfo";

const whatsappNumber = contactInfo.whatsapp[0].replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  "Hola, quisiera información sobre sus productos."
)}`;

// `tel:` y `mailto:` hacen que los datos sean accionables desde el móvil.

const details = [
  {
    label: "Central telefónica",
    values: contactInfo.phones.map((phone) => ({ text: phone, href: telHref(phone) })),
    icon: "phone"
  },
  {
    label: "WhatsApp",
    values: contactInfo.whatsapp.map((value) => ({ text: value, href: whatsappHref })),
    icon: "chat"
  },
  {
    label: "Correos",
    values: contactInfo.emails.map((email) => ({ text: email, href: `mailto:${email}` })),
    icon: "mail"
  },
  {
    label: "Oficina",
    values: [{ text: contactInfo.address }],
    icon: "pin"
  },
  {
    label: "Horario de atención",
    values: [{ text: contactInfo.schedule }],
    icon: "clock"
  }
];

const icons: Record<string, string> = {
  phone: "M3 5a2 2 0 012-2h3l2 5-2 1a11 11 0 005 5l1-2 5 2v3a2 2 0 01-2 2h-1C8 20 4 16 4 11V5z",
  chat: "M21 12a8 8 0 01-11.6 7.1L4 20l1-4.4A8 8 0 1121 12z",
  mail: "M4 4h16v16H4zM4 4l8 7 8-7",
  pin: "M12 21s6-4.5 6-10a6 6 0 10-12 0c0 5.5 6 10 6 10z",
  clock: "M12 6v6l4 2"
};
---

<BaseLayout
  title="Contacto | DIHYC"
  description="Contáctanos para asesoría técnica, productos industriales y servicios especializados."
>
  <Hero
    title="Contacto"
    subtitle="Estamos listos para brindarte asesoría técnica y soluciones industriales."
    ctaLabel="Escríbenos por WhatsApp"
    ctaHref={whatsappHref}
    compact
  />

  <!-- INFO + MAPA -->
  <Section title="Atención al cliente">
    <div class="grid items-start gap-8 md:grid-cols-2 md:gap-10" data-animate>

      <ul class="space-y-5">
        {details.map((detail) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#003595]/10">
              <svg
                class="h-4 w-4 text-[#003595]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                {detail.icon === "clock" && <circle cx="12" cy="12" r="10" />}
                {detail.icon === "pin" && <circle cx="12" cy="11" r="2" />}
                <path d={icons[detail.icon]} />
              </svg>
            </span>

            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900">{detail.label}</p>

              <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700">
                {detail.values.map((value, index) => (
                  <>
                    {index > 0 && <span class="text-gray-300" aria-hidden="true">|</span>}

                    {/* py-1: 28 px de alto, por encima del área táctil mínima de
                        24 px; con 4 números por fila es fácil tocar el vecino. */}
                    {value.href ? (
                      <a
                        href={value.href}
                        class="inline-block break-words py-1 transition hover:text-[#003595] hover:underline"
                      >
                        {value.text}
                      </a>
                    ) : (
                      <span class="break-words">{value.text}</span>
                    )}
                  </>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ul>

      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2680.541816251334!2d-77.04899403904167!3d-12.04769881850536!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c8d163d43f73%3A0x6a07cb1d8b3140fd!2sAv.%20%C3%93scar%20R.%20Benavides%20553%2C%20Lima%2015082!5e0!3m2!1ses-419!2spe!4v1716758089025!5m2!1ses-419!2spe"
        class="h-72 w-full rounded-xl border sm:h-80 md:h-[420px]"
        loading="lazy"
        title="Ubicación de DIHYC en Lima"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>

    </div>
  </Section>

  <!-- FORMULARIO -->
  <Section title="Déjanos un mensaje" class="bg-gray-50">
    <div class="mx-auto max-w-3xl rounded-xl bg-white p-6 shadow-sm sm:p-8">
      <ContactForm />
    </div>
  </Section>

</BaseLayout>
