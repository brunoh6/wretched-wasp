---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import heroSlide3 from "../../assets/hero/slide3.png";
import {
  CERTIFICATIONS_ENABLED,
  CERTIFICATION_TYPES,
  CERTIFICATION_TYPE_LABELS,
  CERTIFICATION_TYPE_DESCRIPTIONS,
  getVisibleCertificationsByType,
  visibleCertifications
} from "../../data/certifications";

/*
 * Por qué esta ruta vive en `certificaciones/[...slug].astro` y no en
 * `certificaciones.astro`:
 *
 * En un sitio estático de Astro 5 sólo las rutas DINÁMICAS pueden decidir en
 * tiempo de build si existen o no, mediante `getStaticPaths()`. Una página
 * plana (`certificaciones.astro`) se emite siempre y su `getStaticPaths()` se
 * ignora. Convirtiéndola en ruta dinámica con parámetro rest y devolviendo un
 * array vacío conseguimos el mismo patrón que usa `productos/[category]/[...linea].astro`
 * con las categorías ocultas: con el flag en `false` no se emite
 * `dist/certificaciones/` en absoluto.
 *
 * `slug: undefined` en el parámetro rest hace que la única ruta generada sea
 * exactamente `/certificaciones` (sin segmentos extra).
 */
export async function getStaticPaths() {
  if (!CERTIFICATIONS_ENABLED) return [];

  return [{ params: { slug: undefined } }];
}

// Grupos con contenido. Si un tipo aún no tiene documentos publicados no se
// dibuja su bloque, para no dejar títulos vacíos en la página.
const groups = CERTIFICATION_TYPES.map((type) => ({
  type,
  label: CERTIFICATION_TYPE_LABELS[type],
  description: CERTIFICATION_TYPE_DESCRIPTIONS[type],
  items: getVisibleCertificationsByType(type)
})).filter((group) => group.items.length > 0);

const hasCertifications = visibleCertifications.length > 0;
---

<BaseLayout
  title="Certificaciones | DIHYC"
  description="Certificados de nuestros proveedores y acreditaciones que respaldan los productos y servicios de H&C."
>

  <Hero
    title="Certificaciones"
    subtitle="Respaldo documentado de los productos que distribuimos y de los servicios que ejecutamos."
    images={[heroSlide3]}
    compact
  />

  <Section>
    <Breadcrumbs items={[{ label: "Certificaciones" }]} />

    <div class="mb-10 max-w-2xl">
      <h2 class="text-2xl font-bold sm:text-3xl">
        Respaldo técnico y documental
      </h2>

      <p class="mt-3 text-gray-600">
        Reunimos en un solo lugar los certificados de nuestros proveedores y las
        acreditaciones que habilitan a nuestro equipo. Cada documento puede
        descargarse en PDF para adjuntarlo a tus expedientes técnicos.
      </p>
    </div>

    {hasCertifications ? (
      <div class="space-y-14">
        {groups.map((group) => (
          <section aria-labelledby={`grupo-${group.type}`}>
            <div class="mb-6 max-w-2xl border-l-4 border-[#003595] pl-4">
              <h3 id={`grupo-${group.type}`} class="text-xl font-semibold text-gray-900 sm:text-2xl">
                {group.label}
              </h3>

              <p class="mt-2 text-sm text-gray-600">
                {group.description}
              </p>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((certification) => (
                <article
                  id={certification.slug}
                  class="flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:-translate-y-1 hover:border-[#003595]/30 hover:shadow-lg"
                  data-animate
                >
                  {certification.image && (
                    <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                      <img
                        src={certification.image}
                        alt={certification.title}
                        loading="lazy"
                        class="img-bright h-full w-full object-contain p-6"
                      />
                    </div>
                  )}

                  <div class="flex flex-1 flex-col p-5">
                    <div class="mb-3 flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-[#003595]/10 px-2.5 py-1 text-xs font-semibold text-[#003595]">
                        {group.label}
                      </span>

                      {certification.year && (
                        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
                          {certification.year}
                        </span>
                      )}
                    </div>

                    <h4 class="text-base font-semibold leading-snug text-gray-900">
                      {certification.title}
                    </h4>

                    <p class="mt-1 text-sm font-medium text-gray-500">
                      {certification.issuer}
                    </p>

                    <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">
                      {certification.description}
                    </p>

                    <div class="mt-5">
                      {certification.file ? (
                        <a
                          href={certification.file}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded border border-[#003595] px-4 py-2 text-sm font-semibold text-[#003595] transition hover:bg-[#003595] hover:text-white"
                        >
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
                          </svg>
                          Descargar certificado
                        </a>
                      ) : (
                        <span class="text-xs font-medium text-gray-500">
                          Documento pendiente
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center">
        <p class="text-base font-medium text-gray-800">
          Estamos digitalizando nuestros certificados
        </p>

        <p class="mx-auto mt-2 max-w-xl text-sm text-gray-600">
          Muy pronto podrás descargarlos desde aquí. Mientras tanto, podemos
          enviarte por correo el documento que necesites para tu expediente.
        </p>

        <a
          href="/contacto/"
          class="cta mt-6 inline-flex items-center justify-center rounded bg-[#003595] px-6 py-3 text-sm font-semibold text-white hover:bg-[#002a75]"
        >
          Solicitar un certificado
        </a>
      </div>
    )}

    <p class="mt-12 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-5 text-sm text-gray-600">
      ¿Necesitas un certificado específico o una carta de respaldo del fabricante?
      <a href="/contacto/" class="font-medium text-[#003595] hover:underline">
        Escríbenos
      </a>
      y te lo hacemos llegar.
    </p>
  </Section>

</BaseLayout>
