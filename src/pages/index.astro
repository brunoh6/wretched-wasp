---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ProductCard from "../components/ProductCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BrandCarousel from "../components/BrandCarousel.astro";
import ContactForm from "../components/ContactForm.astro";
import { getFeaturedFmProducts } from "../data/catalogDisplayItems";
import heroHome from "../assets/hero/home.png";
import heroNuestraEmpresa from "../assets/hero/nuestraempresa.png";
import heroSlide3 from "../assets/hero/slide3.png";
import heroSlide4 from "../assets/hero/slide4.png";

// La portada destaca el catálogo FM publicado (tuberías y conexiones).
const featuredProducts = getFeaturedFmProducts(8);

const brands = [
  { name: "+GF+", logo: "/assets/brands/gf.png" },
  { name: "Leister", logo: "/assets/brands/leister.png" },
  { name: "Simona", logo: "/assets/brands/simona.png" },
  { name: "Integrity", logo: "/assets/brands/integrity.png" },
  { name: "Arrow", logo: "/assets/brands/arrow.png" },
  { name: "Cepex", logo: "/assets/brands/cepex.png" },
  { name: "Cim", logo: "/assets/brands/cim.png" },
  { name: "Era", logo: "/assets/brands/era.png" }
];
---

<BaseLayout
  title="DIHYC | Tubosistemas y conexiones certificadas FM"
  description="Distribución e importación de tuberías, conexiones y planchas termoplásticas de alta calidad para la industria peruana."
>

  <!-- HERO -->
  <Hero
    title="Diversos productos en tubosistemas y conexiones"
    subtitle="Tuberías y conexiones HDPE con certificación FM Approved para sistemas contra incendio, con respaldo técnico especializado."
    ctaLabel="Conoce nuestros productos"
    ctaHref="/productos/"
    secondaryLabel="Habla con un especialista"
    secondaryHref="/contacto/"
    images={[heroHome, heroNuestraEmpresa, heroSlide3, heroSlide4]}
  />

  <!-- EMPRESA -->
  <Section title="Nuestra Empresa">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12" data-animate>

      <div class="overflow-hidden rounded-xl shadow-lg">
        <img
          src="/assets/hero/empresa.png"
          alt="Planta y equipo de DIHYC"
          loading="lazy"
          class="img-bright h-64 w-full object-cover sm:h-80 md:h-[380px]"
        />
      </div>

      <div>
        <p class="leading-relaxed text-gray-700">
          H&C es la principal distribuidora e importadora de productos de alta
          calidad para diversas industrias en Perú.
        </p>

        <p class="mt-4 leading-relaxed text-gray-700">
          Ofrecemos una amplia <b>gama de productos</b>, que incluye planchas y
          perfiles de PVC-CPVC-HDPE-PPE, Teflón, tubos, conexiones PVC,
          polietileno, propileno, pegamento y válvulas de PVC, así como también
          fierro fundido.
        </p>

        <a
          href="/empresa/"
          class="mt-6 inline-block rounded bg-[#003595] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#002a75]"
        >
          Conócenos
        </a>
      </div>
    </div>
  </Section>

  <!-- PRODUCTOS DESTACADOS -->
  <Section
    title="Catálogo FM Approved"
    subtitle="Tuberías y conexiones HDPE certificadas para sistemas contra incendio. Cada producto incluye su ficha técnica descargable."
  >
    <div class="relative" data-animate>
      <div
        id="productCarousel"
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
      >
        {featuredProducts.map((product) => (
          <div class="w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[31%] xl:w-[23.5%]">
            <ProductCard
              title={product.productName}
              subtitle={`${product.brand} · ${product.sizeRange ?? ""}`}
              image={product.productImage}
              href={`/productos/${product.category}/`}
              badge={product.certification}
            />
          </div>
        ))}
      </div>

      <button
        id="prevProductBtn"
        type="button"
        aria-label="Productos anteriores"
        class="carousel-arrow absolute -left-3 top-1/2 hidden -translate-y-1/2 lg:flex"
      >
        ‹
      </button>

      <button
        id="nextProductBtn"
        type="button"
        aria-label="Productos siguientes"
        class="carousel-arrow absolute -right-3 top-1/2 hidden -translate-y-1/2 lg:flex"
      >
        ›
      </button>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/productos/"
        class="cta inline-block rounded bg-[#003595] px-6 py-3 text-sm font-semibold text-white hover:bg-[#002a75]"
      >
        Ver todo el catálogo
      </a>

      <a
        href="/contacto/"
        class="inline-block rounded border border-gray-300 px-6 py-3 text-sm font-medium transition hover:border-gray-900 hover:bg-gray-900 hover:text-white"
      >
        Solicitar cotización
      </a>
    </div>
  </Section>

  <!-- SERVICIOS DESTACADOS -->
  <Section
    title="Servicios especializados en soldadura industrial"
    subtitle="Ejecución técnica para uniones seguras y duraderas en obra."
    class="bg-gray-50"
  >
    <div class="grid gap-6 md:grid-cols-2 md:gap-8" data-animate>
      <ServiceCard
        title="Soldadura por Termofusión"
        description="Unión de tuberías plásticas con máxima resistencia y seguridad."
        image="/assets/services/termofusion.png"
      />

      <ServiceCard
        title="Soldadura por Electrofusión"
        description="Instalaciones industriales con alta precisión y confiabilidad."
        image="/assets/services/electrofusion.png"
      />
    </div>

    <a
      href="/servicios/"
      class="mt-8 inline-block rounded border border-gray-300 px-6 py-3 text-sm font-medium transition hover:border-gray-900 hover:bg-gray-900 hover:text-white"
    >
      Ver todos los servicios
    </a>
  </Section>

  <!-- MARCAS -->
  <Section title="Distribuimos las mejores marcas" tight>
    <BrandCarousel brands={brands} />
  </Section>

  <!-- FORMULARIO -->
  <section class="bg-gray-100 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="rounded-xl bg-white p-6 shadow-lg sm:p-10">
        <h2 class="mb-2 text-center text-2xl font-semibold sm:text-3xl">
          Solicita información
        </h2>

        <p class="mb-8 text-center text-sm text-gray-600">
          Cuéntanos qué necesitas y un especialista te contactará.
        </p>

        <ContactForm />
      </div>
    </div>
  </section>

  <style>
    /* Oculta la barra de scroll del carrusel sin perder el desplazamiento. */
    #productCarousel {
      scrollbar-width: none;
    }

    #productCarousel::-webkit-scrollbar {
      display: none;
    }

    .carousel-arrow {
      height: 2.75rem;
      width: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background-color: #fff;
      font-size: 1.25rem;
      color: #111827;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.16);
      transition: background-color 0.2s ease, opacity 0.2s ease;
    }

    .carousel-arrow:hover {
      background-color: #f3f4f6;
    }

    .carousel-arrow[disabled] {
      opacity: 0;
      pointer-events: none;
    }
  </style>

  <script>
    // Carrusel basado en scroll nativo: se adapta solo a cualquier ancho y
    // permite deslizar con el dedo en móvil sin cálculos de posición.
    const carousel = document.getElementById("productCarousel");
    const nextBtn = document.getElementById("nextProductBtn");
    const prevBtn = document.getElementById("prevProductBtn");

    if (carousel) {
      const step = () => {
        const card = carousel.firstElementChild as HTMLElement | null;
        return card ? card.offsetWidth + 16 : carousel.clientWidth;
      };

      const scrollByStep = (direction: number) =>
        carousel.scrollBy({ left: direction * step(), behavior: "smooth" });

      nextBtn?.addEventListener("click", () => scrollByStep(1));
      prevBtn?.addEventListener("click", () => scrollByStep(-1));

      // Las flechas se desactivan al llegar a cada extremo.
      const syncArrows = () => {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth - 4;

        prevBtn?.toggleAttribute("disabled", carousel.scrollLeft <= 4);
        nextBtn?.toggleAttribute("disabled", carousel.scrollLeft >= maxScroll);
      };

      carousel.addEventListener("scroll", syncArrows, { passive: true });
      window.addEventListener("resize", syncArrows);
      syncArrows();
    }
  </script>

</BaseLayout>
