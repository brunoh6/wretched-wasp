---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import cardsData from "../data/catalog/cards.json";

/**
 * Tarjeta de la portada de productos.
 *
 * Vive en `src/data/catalog/cards.json` y NO en `src/data/categories.ts` porque
 * son dos cosas distintas: `categories.ts` decide qué FAMILIAS existen como
 * ruta (/productos/tuberias, /productos/conexiones) y qué entra al menú, y hoy
 * cada familia mezcla las dos líneas comerciales. La portada, en cambio,
 * necesita cuatro entradas —una por familia y línea— para que el cliente entre
 * directo a lo que busca. Además el panel de administración edita la imagen de
 * cada tarjeta (decisión D7), y ese archivo tiene que ser un JSON editable sin
 * tocar código.
 */
type CatalogCard = {
  slug: string;
  /** Familia publicada: coincide con el slug de la ruta /productos/[category]. */
  family: string;
  /** Línea comercial: "fm" = contra incendio, "agua" = agua fría/caliente. */
  line: string;
  title: string;
  subtitle: string;
  image: string;
  visible: boolean;
  order: number;
};

// `visible` permite apagar una tarjeta desde el CMS sin borrar su fila, y
// `order` fija el orden mostrado sin depender de cómo quedó ordenado el JSON.
const cards = (cardsData.cards as CatalogCard[])
  .filter((card) => card.visible)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Productos | DIHYC"
  description="Tuberías y conexiones de dos líneas: contra incendio en HDPE certificado FM Approved, y agua fría y caliente en PVC y CPVC. Filtra por medida, marca y aplicación."
>

  <Section>
    <Breadcrumbs items={[{ label: "Productos" }]} />

    <div class="mb-8 max-w-2xl">
      <h1 class="text-3xl font-semibold sm:text-4xl">
        Productos
      </h1>

      <p class="mt-3 text-gray-600">
        Nuestro catálogo reúne dos líneas: contra incendio, con tuberías y conexiones
        de HDPE certificadas
        <span class="font-semibold text-[#003595]">FM Approved</span>,
        y agua fría y caliente, con tuberías y conexiones de PVC y CPVC. Puedes
        filtrar por medida, marca y aplicación, y descargar la ficha técnica de los
        productos que ya la tienen disponible.
      </p>
    </div>

    <!-- Cuatro tarjetas: 1 columna en móvil, 2 en tablet y 4 en escritorio.
         Se descarta el 2x2 en `lg` porque las cuatro entradas forman un único
         nivel de decisión (familia + línea) y partirlas en dos filas sugiere una
         jerarquía que no existe; en una sola fila el cliente las compara de un
         vistazo. `items-stretch` + `h-full` igualan la altura de las tarjetas
         aunque un subtítulo ocupe dos líneas y otro sólo una.
         La primera foto es el elemento más grande de la primera pantalla (LCP):
         va sin lazy y con prioridad alta. width/height (4:3, como la caja)
         reservan el hueco antes de que llegue la imagen. -->
    <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((card, index) => (
        <a
          href={`/productos/${card.family}/?linea=${card.line}`}
          class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:-translate-y-1 hover:border-[#003595]/30 hover:shadow-lg"
        >
          <div class="aspect-[4/3] overflow-hidden bg-gray-100">
            <img
              src={card.image}
              alt={`${card.title} — ${card.subtitle}`}
              width="800"
              height="600"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
              class="img-bright h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="flex items-start justify-between gap-3 p-5">
            <div>
              <h2 class="text-lg font-semibold text-gray-900">
                {card.title}
              </h2>

              <p class="mt-1 text-sm text-gray-600">
                {card.subtitle}
              </p>

              <p class="mt-2 text-sm text-gray-500">
                Ver catálogo
              </p>
            </div>

            <span
              class="shrink-0 text-xl text-gray-300 transition group-hover:translate-x-1 group-hover:text-[#003595]"
              aria-hidden="true"
            >
              →
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-10 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-5 text-sm text-gray-600">
      Estamos incorporando progresivamente el resto de líneas (válvulas, planchas,
      pegamentos, perfiles y máquinas) conforme completamos su información y fichas
      técnicas.
      <a href="/contacto/" class="font-medium text-[#003595] hover:underline">
        Consúltanos por disponibilidad
      </a>.
    </p>
  </Section>

</BaseLayout>
