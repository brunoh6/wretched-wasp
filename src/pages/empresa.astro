---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ValueCard from "../components/ValueCard.astro";
---

<BaseLayout
  title="Empresa | DIHYC"
  description="Conoce a DIHYC, nuestra experiencia, valores y compromiso en la distribución de productos y servicios industriales."
>
  <!-- HERO -->
  <Hero
    title="Nuestra Empresa"
    subtitle="Comprometidos con la calidad, el respaldo técnico y soluciones industriales confiables."
    images={["/assets/hero/nuestraempresa.png"]}
    compact
  />

<!-- QUIÉNES SOMOS -->
<Section>
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12" data-animate>

    <!-- Columna izquierda -->
    <div>
      <h2 class="mb-5 text-2xl font-bold sm:text-3xl">
        ¿Quiénes somos?
      </h2>

      <p class="mb-4 text-lg font-medium text-[#003595]">
        37 años como la autoridad en soluciones termoplásticas de alta ingeniería.
      </p>

      <p class="mb-4 leading-relaxed text-gray-700">
        Liderando el mercado peruano, en H&C no sólo importamos: distribuimos y
        fabricamos productos plásticos en PVC, HDPE y PP, blindando sus proyectos
        con estándares de calidad superior. Nos especializamos en transformar
        desafíos técnicos en soluciones de alta eficiencia para los sectores
        industrial, minero, agrícola, pesquero y de construcción a nivel nacional.
      </p>

      <p class="leading-relaxed text-gray-700">
        Nuestra diferencia es absoluta: calidad certificada y asesoría técnica de
        élite. No buscamos cumplir requisitos, buscamos elevar el estándar de cada
        obra, garantizando durabilidad extrema y seguridad operativa. Somos el
        aliado estratégico donde la precisión técnica y el compromiso con la
        excelencia se encuentran para asegurar el éxito de su inversión.
      </p>

      <dl class="mt-8 grid grid-cols-3 gap-4 border-t pt-6">
        <div>
          <dt class="text-2xl font-bold text-[#003595]">37</dt>
          <dd class="text-xs text-gray-600">años en el mercado</dd>
        </div>

        <div>
          <dt class="text-2xl font-bold text-[#003595]">FM</dt>
          <dd class="text-xs text-gray-600">línea certificada</dd>
        </div>

        <div>
          <dt class="text-2xl font-bold text-[#003595]">5</dt>
          <dd class="text-xs text-gray-600">sectores atendidos</dd>
        </div>
      </dl>
    </div>

    <!-- Columna derecha -->
    <div class="overflow-hidden rounded-xl shadow-md">
      <img
        src="/assets/hero/empresa.png"
        alt="Equipo técnico de DIHYC en planta"
        loading="lazy"
        class="img-bright h-64 w-full object-cover sm:h-80 md:h-[420px]"
      />
    </div>

  </div>
</Section>

<!-- LO QUE NOS DEFINE -->
<!--
  Los tres textos se mantienen en 23-25 palabras para que las tarjetas tengan
  un peso visual parejo. items-stretch fuerza la misma altura en la fila
  (ValueCard ya trae h-full para ocupar toda la celda).
-->
<Section title="Lo que nos define" class="bg-gray-50">
  <div class="grid items-stretch gap-6 md:grid-cols-3 md:gap-8" data-animate>

    <ValueCard
      title="Misión"
      icon="🎯"
      text="Brindar soluciones integrales en tuberías y termoplásticos certificados para industria, minería, saneamiento, gas, agroindustria y construcción, con stock permanente y asesoría técnica especializada."
    />

    <ValueCard
      title="Visión"
      icon="🔭"
      text="Ser el referente nacional en soluciones plásticas industriales y unión segura, socio estratégico de las principales empresas del país y siempre La casa del PVC."
    />

    <ValueCard
      title="Valores"
      icon="🤝"
      text="Calidad, responsabilidad, transparencia, compromiso y orientación al cliente: principios que guían cada asesoría técnica, cada entrega y cada relación comercial de largo plazo."
    />

  </div>
</Section>

  <!-- CTA SUAVE -->
  <Section tight>
    <div class="text-center">
      <p class="mx-auto max-w-2xl text-gray-700">
        Si deseas conocer más sobre nuestros productos o servicios, estaremos
        encantados de atenderte.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/contacto/"
          class="rounded bg-[#003595] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#002a75]"
        >
          Contáctanos
        </a>

        <a
          href="/productos/"
          class="rounded border border-gray-300 px-6 py-3 text-sm font-medium transition hover:border-gray-900 hover:bg-gray-900 hover:text-white"
        >
          Ver productos
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>