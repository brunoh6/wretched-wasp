---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getImage } from "astro:assets";
import ogFoto from "../assets/hero/slide3.png";
import { searchIndex, SEARCH_SYNONYMS, popularSearches } from "../data/searchIndex";

// El índice viaja una sola vez por página. Vive aquí y no en SearchBar porque
// el Header monta el buscador dos veces (escritorio y móvil) y el JSON se
// duplicaba en cada página sin que nadie leyera la segunda copia.
const searchPayload = {
  items: searchIndex,
  synonyms: SEARCH_SYNONYMS,
  popular: popularSearches
};

const {
  title = "H & C | DIHYC",
  // Sin "planchas" mientras esa categoría no esté publicada: la descripción no
  // debe prometer algo que el catálogo no muestra.
  description = "Distribuidora e importadora de tuberías y conexiones termoplásticas para la industria en Perú.",
  /**
   * `true` en páginas que no deben aparecer en buscadores (la 404). Emite
   * `<meta name="robots" content="noindex">` y omite el canonical: una página
   * de error no tiene una URL "canónica" que proponer a Google.
   */
  noindex = false
} = Astro.props;

// Todas las URLs absolutas salen de `site` (astro.config.mjs) y NUNCA del
// origen de la petición. Antes se usaba `Astro.url.origin` como respaldo y el
// build escribía "http://localhost:4321/..." en el canonical, que es justo lo
// que Google no debe ver. Si algún día faltara `site`, preferimos no emitir
// canonical ni og:url antes que publicar uno incorrecto.
const site = Astro.site;

// Forma de la ruta: comprobado en el build estático, con build.format
// 'directory' Astro entrega `Astro.url.pathname` CON barra final
// ("/productos/tuberias/"), que es la forma canónica acordada (D2: la que
// Apache sirve con 200). Por eso se usa tal cual, sin normalizar. La query
// (?linea=fm) no forma parte de `pathname`, así que las variantes filtradas
// del catálogo apuntan todas a la misma URL canónica.
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : undefined;

// og:image tiene que ser ABSOLUTA: Facebook, WhatsApp o LinkedIn no resuelven
// rutas relativas y el enlace compartido saldría sin imagen. JPEG de 1200 px:
// el formato y el ancho que todas esas plataformas aceptan.
const ogImageAsset = await getImage({ src: ogFoto, width: 1200, format: "jpg", quality: 82 });
const ogImage = site ? new URL(ogImageAsset.src, site).href : ogImageAsset.src;

// Marca de build (contrato con la GitHub Action): la Action compila con
// PUBLIC_BUILD_ID=<sha del commit> y, tras publicar, comprueba que el HTML en
// vivo trae ese mismo valor. Así distingue "se ve la versión nueva" de "el
// servidor o una caché sigue sirviendo la anterior". En local no hay SHA y se
// emite "local". Es pública a propósito: un SHA de commit no es un secreto.
const buildId = import.meta.env.PUBLIC_BUILD_ID ?? "local";

// Medición: Google Ads, Google Analytics 4 y Microsoft Clarity (README-deploy.md,
// sección 6). Cada una se activa SÓLO con su variable del build; sin ninguna no
// se carga nada de Google ni de Microsoft y la página sólo lleva el escucha de
// abajo, que deja los eventos en window.dataLayer. Los mismos IDs amplían la
// CSP de dist/.htaccess (scripts/csp-medicion.mjs): si se cambia una
// validación aquí, cambiarla allí. Acceso estático a cada variable: Vite sólo
// sustituye `import.meta.env.X` escrito tal cual.
const limpiar = (valor: unknown) => String(valor ?? "").trim();
const adsId = limpiar(import.meta.env.PUBLIC_GOOGLE_ADS_ID);
const ga4Id = limpiar(import.meta.env.PUBLIC_GA4_ID);
const clarityId = limpiar(import.meta.env.PUBLIC_CLARITY_ID);
const adsEtiquetas = {
  whatsapp: limpiar(import.meta.env.PUBLIC_ADS_LABEL_WHATSAPP),
  formulario: limpiar(import.meta.env.PUBLIC_ADS_LABEL_FORMULARIO),
  llamada: limpiar(import.meta.env.PUBLIC_ADS_LABEL_LLAMADA)
};
// Un valor mal copiado debe parar el build: si no, la campaña arrancaría sin
// medir y nadie lo notaría hasta ver cero conversiones o cero visitas.
if (adsId && !/^AW-\d+$/.test(adsId)) {
  throw new Error(`PUBLIC_GOOGLE_ADS_ID="${adsId}" no tiene la forma AW-123456789`);
}
for (const [tipo, etiqueta] of Object.entries(adsEtiquetas)) {
  if (etiqueta && !/^[A-Za-z0-9_-]+$/.test(etiqueta)) {
    throw new Error(`La etiqueta de conversión de ${tipo} ("${etiqueta}") sólo puede llevar letras, números, - y _`);
  }
}
// GA4: el «ID de medición» del flujo web (G- y mayúsculas/números). El ID de
// la propiedad o del flujo (sólo números) NO sirve.
if (ga4Id && !/^G-[A-Z0-9]+$/.test(ga4Id)) {
  throw new Error(`PUBLIC_GA4_ID="${ga4Id}" no tiene la forma G-XXXXXXXXXX (el «ID de medición» del flujo web)`);
}
// Clarity: el «ID del proyecto», 10 letras minúsculas y números (p. ej. el
// proyecto de demostración de la documentación de Microsoft, 3t0wlogvdz).
if (clarityId && !/^[a-z0-9]{10}$/.test(clarityId)) {
  throw new Error(`PUBLIC_CLARITY_ID="${clarityId}" no tiene la forma de un ID de proyecto de Clarity (10 letras minúsculas y números)`);
}
// Una sola etiqueta de Google (gtag.js) para Ads y GA4: se carga con el primer
// ID y cada producto se configura con su propio "config"
// (developers.google.com/tag-platform/gtagjs/install). Ads va primero para que
// una compilación sólo con Ads siga cargando gtag.js?id=AW-….
const gtagIds = [adsId, ga4Id].filter(Boolean);
const medicion = { id: adsId, etiquetas: adsId ? adsEtiquetas : {}, ga4: ga4Id };
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {gtagIds.length > 0 && (
      <>
        {/* Etiqueta de Google (gtag.js) para Google Ads y/o GA4, según la guía
            oficial developers.google.com/tag-platform/gtagjs/install: al
            principio del <head> de cada página, cargada UNA vez y con un
            "config" por ID. El "config" de GA4 envía por sí solo el page_view de cada
            página. define:vars envuelve el código en una función, por eso gtag
            se asigna a window en vez de declararse con "function". */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`}></script>
        <script is:inline define:vars={{ gtagIds }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          gtagIds.forEach(function (id) { window.gtag("config", id); });
        </script>
      </>
    )}

    {clarityId && (
      /* Microsoft Clarity: el código de seguimiento oficial, en el <head>
         (learn.microsoft.com/clarity/setup-and-installation/clarity-setup).
         Carga asíncrona: no frena la página. Los campos de texto y las listas
         se enmascaran siempre en Clarity, y el formulario de contacto además
         lleva data-clarity-mask (ContactForm.astro). */
      <script is:inline define:vars={{ clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}

    {/* Escucha único de la medición. Delegado en document para cubrir también
        lo que el catálogo pinta después (casillas «Cotizar», fichas, botón de
        cotización).
        - Conversiones (WhatsApp, llamada y el evento "dihyc:conversion" del
          formulario): { event: "dihyc_conversion", tipo } en dataLayer, como
          siempre, y la conversión de Google Ads si hay etiqueta.
        - Embudo de cotización: cada evento queda SIEMPRE en dataLayer como
          { event: "dihyc_<nombre>", …parámetros } y, sólo si hay GA4, se envía
          a GA4 con gtag("event", nombre, …) y send_to = el ID de GA4 (Ads no
          recibe estos eventos). Nombres y parámetros en README-deploy.md,
          sección 6. Nunca se envían valores del formulario ni datos de
          contacto: sólo de dónde vino el clic, qué producto, filtro o ficha,
          y qué se buscó en el buscador de productos.
        - formulario_enviado va acompañado de generate_lead, el evento
          recomendado de Google para un contacto (sin valor: la empresa no
          asigna un monto a cada consulta).
        - cotizar_marcado lleva el nombre visible de la fila del catálogo
          (producto · material · marca); si el catálogo cambiara su HTML, queda el
          código de la casilla. Cotizar y filtros cuentan sólo al MARCAR: lo
          que el catálogo marca o desmarca por código (filtros de la URL,
          opciones imposibles) no dispara "change".
        - Búsquedas: las que llevan al catálogo con ?q= las registra sola la
          medición mejorada de GA4 (view_search_results); este script no las
          repite. Las que no llegan ahí (Enter o clic hacia un resultado
          suelto, "Sin resultados") las avisa SearchBar con "dihyc:busqueda" y
          salen como busqueda {termino, resultados: si|no}. Un término con @ o
          7 o más dígitos seguidos, aunque vayan separados por espacios,
          puntos o guiones (correo, teléfono), no se envía.
        No llama a preventDefault: la navegación sigue sola y transport_type
        "beacon" hace que el aviso a Google sobreviva a la salida de la página
        (Google sugiere retrasar el enlace con event_callback; aquí no, para no
        frenar nunca el paso a WhatsApp). La espera de 1 s evita que un doble
        clic cuente dos veces; auxclick cuenta sólo la rueda (abrir en otra
        pestaña), no el botón derecho. Los comentarios van aquí fuera para no
        repetirlos en el HTML de cada página. */}
    <script is:inline define:vars={{ medicion }}>
      window.dataLayer = window.dataLayer || [];
      var ultimo = {};
      var PAGINAS = { inicio: "inicio", productos: "catalogo", contacto: "contacto", servicios: "servicios", empresa: "empresa", certificaciones: "certificaciones" };

      function primeraVez(clave) {
        var ahora = Date.now();
        if (ahora - (ultimo[clave] || 0) < 1000) return false;
        ultimo[clave] = ahora;
        return true;
      }

      function corto(texto) {
        return String(texto || "").replace(/\s+/g, " ").trim().slice(0, 100);
      }

      function medir(nombre, parametros, salida) {
        var datos = { event: "dihyc_" + nombre };
        var ga4 = { send_to: medicion.ga4 };
        for (var clave in parametros) datos[clave] = ga4[clave] = parametros[clave];
        window.dataLayer.push(datos);
        if (medicion.ga4 && typeof window.gtag === "function") {
          if (salida) ga4.transport_type = "beacon";
          window.gtag("event", nombre, ga4);
        }
      }

      function origenDePagina() {
        return PAGINAS[location.pathname.split("/")[1] || "inicio"] || "otra";
      }

      function origenDe(enlace) {
        if (enlace.id === "quoteWhatsapp") return "cotizacion";
        if (enlace.matches("body > a.fixed")) return "boton_flotante";
        if (enlace.closest("footer")) return "pie";
        if (enlace.closest("header")) return "cabecera";
        return origenDePagina();
      }

      function registrar(tipo, origen) {
        if (!primeraVez(tipo)) return;
        window.dataLayer.push({ event: "dihyc_conversion", tipo: tipo });
        var etiqueta = medicion.id && Object.prototype.hasOwnProperty.call(medicion.etiquetas, tipo) && medicion.etiquetas[tipo];
        if (etiqueta && typeof window.gtag === "function") {
          window.gtag("event", "conversion", {
            send_to: medicion.id + "/" + etiqueta,
            transport_type: "beacon"
          });
        }
        if (tipo === "whatsapp") medir("clic_whatsapp", { origen: origen }, true);
        else if (tipo === "llamada") medir("clic_telefono", { origen: origen }, true);
        else if (tipo === "formulario") {
          medir("formulario_enviado", { origen: origen });
          if (medicion.ga4 && typeof window.gtag === "function") {
            window.gtag("event", "generate_lead", { send_to: medicion.ga4, lead_source: "formulario_web" });
          }
        }
      }

      function urlDe(enlace) {
        try {
          return new URL(enlace.getAttribute("href"), location.href);
        } catch (error) {
          return null;
        }
      }

      function tipoDeEnlace(url) {
        if (url.protocol === "tel:") return "llamada";
        if (/^https?:$/.test(url.protocol) && (url.hostname === "wa.me" || url.hostname === "api.whatsapp.com")) {
          return "whatsapp";
        }
        return null;
      }

      function fichaDe(url) {
        if (url.host !== location.host || !/^\/assets\/(fichas-tecnicas|panel\/fichas)\/[^/]+\.pdf$/i.test(url.pathname)) return null;
        var nombre = url.pathname.split("/").pop();
        try {
          nombre = decodeURIComponent(nombre);
        } catch (error) {}
        return corto(nombre);
      }

      function alClic(evento) {
        if (evento.defaultPrevented) return;
        if (evento.type === "auxclick" && evento.button !== 1) return;
        var enlace = evento.target instanceof Element ? evento.target.closest("a[href]") : null;
        var url = enlace && urlDe(enlace);
        if (!url) return;
        var tipo = tipoDeEnlace(url);
        if (tipo) return registrar(tipo, origenDe(enlace));
        var archivo = fichaDe(url);
        if (archivo && primeraVez("ficha:" + archivo)) medir("ficha_descargada", { archivo: archivo }, true);
      }

      function productoDe(casilla) {
        var fila = casilla.closest("tr") || casilla.closest(".rounded-lg");
        var nombre = fila && fila.querySelector(".capitalize");
        var material = fila && fila.querySelector(".text-xs.uppercase");
        var bloque = casilla.closest(".rounded-xl");
        var marca = bloque && bloque.querySelector("h2");
        var texto = [nombre, material, marca].filter(Boolean).map(function (el) { return corto(el.textContent); }).filter(Boolean).join(" · ");
        return corto(texto || casilla.closest("[data-quote-id]").getAttribute("data-quote-id"));
      }

      function alCambiar(evento) {
        var casilla = evento.target;
        if (!(casilla instanceof HTMLInputElement) || casilla.type !== "checkbox" || !casilla.checked) return;
        if (casilla.closest("[data-quote-id]")) return medir("cotizar_marcado", { producto: productoDe(casilla) });
        var faceta = casilla.closest("[data-facet]");
        if (faceta) medir("filtro_aplicado", { faceta: faceta.getAttribute("data-facet"), valor: corto(casilla.value) });
      }

      document.addEventListener("click", alClic);
      document.addEventListener("auxclick", alClic);
      document.addEventListener("change", alCambiar);
      document.addEventListener("dihyc:conversion", function (evento) {
        var tipo = evento.detail && evento.detail.tipo;
        if (typeof tipo === "string" && tipo) registrar(tipo, origenDePagina());
      });
      document.addEventListener("dihyc:busqueda", function (evento) {
        var detalle = evento.detail || {};
        var termino = corto(detalle.termino);
        if (!termino || /@|(\d[\s.-]?){7,}/.test(termino)) return;
        medir("busqueda", { termino: termino, resultados: detalle.resultados === "si" ? "si" : "no" }, true);
      });
    </script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta name="theme-color" content="#003595" />
    <meta name="dihyc-build" content={buildId} />

    <!-- Open Graph: cómo se ve el enlace al compartirlo -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DIHYC" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_PE" />

    <!-- ?v=N obliga al navegador a pedir el ícono otra vez: los íconos se
         guardan en caché aparte y no se renuevan al recargar. Subir N si se
         cambian los archivos. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <!-- Columna flex: el footer queda al fondo en páginas cortas sin necesidad
       de un `min-h-screen` en <main>, que abría un hueco en las páginas largas. -->
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-[#003595] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>

    <script class="search-data" type="application/json" set:html={JSON.stringify(searchPayload)}></script>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <script>
      // Revelado progresivo de bloques marcados con `data-animate`.
      const animated = document.querySelectorAll<HTMLElement>("[data-animate]");

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        animated.forEach((el) => el.classList.add("in-view"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("in-view");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
        );

        animated.forEach((el, index) => {
          // El retardo se reinicia cada 4 elementos para que una fila entre
          // casi a la vez en lugar de encadenar esperas largas.
          el.style.transitionDelay = `${(index % 4) * 90}ms`;
          observer.observe(el);
        });
      }
    </script>

    <script>
      // Estado compacto/translúcido del navbar al hacer scroll.
      const navbar = document.getElementById("site-navbar");

      if (navbar) {
        let ticking = false;

        const update = () => {
          navbar.classList.toggle("navbar-scrolled", window.scrollY > 20);
          ticking = false;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true }
        );

        update();
      }
    </script>
  </body>
</html>
