---
import { getImage } from "astro:assets";
import fotoPorDefecto from "../assets/hero/home.png";

const {
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  /**
   * Fotos importadas desde src/assets (no rutas de public/): así Astro las
   * convierte a WebP en varios tamaños y el móvil descarga la pequeña. Una
   * ruta en texto sigue funcionando, pero se sirve tal cual, sin optimizar.
   */
  images = [fotoPorDefecto],
  /** `compact` para páginas interiores, donde el hero es sólo encabezado. */
  compact = false
} = Astro.props;

// Tolera `images` como string suelto además de array.
const slides = (Array.isArray(images) ? images : [images]).filter(Boolean);
const hasCarousel = slides.length > 1;

// Con sólo [960, 1920], un móvil 1080p (412 px a DPR 2,625) bajaba la de 1920;
// con el paso de 1280 baja una bastante más liviana que se ve igual.
const SIZES = "100vw";
const slideImages = await Promise.all(
  slides.map(async (image) => {
    if (typeof image === "string") return { src: image };

    const optimized = await getImage({
      src: image,
      widths: [640, 960, 1280, 1920],
      sizes: SIZES,
      format: "webp",
      quality: 78
    });

    return {
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      sizes: SIZES,
      width: optimized.attributes.width,
      height: optimized.attributes.height
    };
  })
);

const heightClass = compact
  ? "min-h-[38vh] md:min-h-[42vh]"
  : "min-h-[62vh] md:min-h-[68vh]";
---

<section
  id="hero-carousel"
  class={`relative isolate flex ${heightClass} items-center overflow-hidden bg-gray-900 text-white`}
>

  <!-- CAPA DE IMÁGENES -->
  <div class="absolute inset-0">
    <!-- Sólo la primera foto lleva src. Las demás llevan data-src/data-srcset/
         data-sizes y el script las asigna tras el evento load (o antes, si el
         usuario las pide): ocultas con opacity-0 siguen dentro del viewport,
         así que loading="lazy" no las frenaba y competían con la primera. -->
    {slideImages.map((image, index) => (
      <div
        class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-out ${
          index === 0 ? "opacity-100" : "opacity-0"
        }`}
        data-slide={index}
        aria-hidden="true"
      >
        {index === 0 ? (
          <img
            src={image.src}
            srcset={image.srcset}
            sizes={image.sizes}
            width={image.width}
            height={image.height}
            alt=""
            class="img-bright-hero absolute inset-0 h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <img
            data-src={image.src}
            data-srcset={image.srcset}
            data-sizes={image.sizes}
            width={image.width}
            height={image.height}
            alt=""
            class="img-bright-hero absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    ))}

    <!-- Velo: en móvil el texto ocupa todo el ancho y un degradado lateral lo
         dejaba sobre zonas claras, así que ahí oscurece toda la foto. Desde sm
         el texto va a la izquierda y basta el degradado direccional. -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/55 to-black/45 sm:bg-gradient-to-r sm:from-black/65 sm:via-black/35 sm:to-black/10"
      aria-hidden="true"
    ></div>
  </div>

  <!-- CONTENIDO: vive fuera de los slides, así el CTA nunca desaparece -->
  <!-- Con carrusel, sm:px-20 deja libre la franja de las flechas (left-3 + 44 px):
       sin ese margen la flecha "‹" tapaba la primera letra del título. -->
  <div class={`relative z-20 mx-auto w-full max-w-7xl px-6 py-14 md:py-20 ${hasCarousel ? "sm:px-20" : ""}`}>
    <div class="max-w-2xl">
      {title && (
        <h1 class="text-3xl font-bold leading-tight drop-shadow-sm sm:text-4xl md:text-5xl">
          {title}
        </h1>
      )}

      {subtitle && (
        <p class="mt-4 max-w-xl text-base text-gray-100 md:mt-5 md:text-lg">
          {subtitle}
        </p>
      )}

      {((ctaLabel && ctaHref) || (secondaryLabel && secondaryHref)) && (
        <div class="mt-7 flex flex-wrap gap-3">
          {ctaLabel && ctaHref && (
            <a
              href={ctaHref}
              class="cta inline-flex items-center justify-center rounded bg-[#003595] px-6 py-3 text-sm font-semibold text-white hover:bg-[#002a75]"
            >
              {ctaLabel}
            </a>
          )}

          {secondaryLabel && secondaryHref && (
            <a
              href={secondaryHref}
              class="inline-flex items-center justify-center rounded border border-white/70 bg-black/40 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white hover:text-gray-900"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  {hasCarousel && (
    <>
      <!-- Flechas: ocultas en móvil, donde mandan el swipe y los puntos -->
      <button
        id="hero-prev"
        type="button"
        class="absolute left-3 top-1/2 z-30 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/35 text-xl text-white backdrop-blur-sm transition hover:bg-black/60 sm:flex"
        aria-label="Imagen anterior"
      >
        ‹
      </button>

      <button
        id="hero-next"
        type="button"
        class="absolute right-3 top-1/2 z-30 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/35 text-xl text-white backdrop-blur-sm transition hover:bg-black/60 sm:flex"
        aria-label="Imagen siguiente"
      >
        ›
      </button>

      <!-- El botón (p-2) da un área táctil de 26 px o más; el punto visible es
           el span de dentro. bottom-3 + p-2 deja el punto donde estaba. -->
      <div class="absolute bottom-3 left-1/2 z-30 flex -translate-x-1/2">
        {slides.map((_, index) => (
          <button
            type="button"
            class="hero-dot group/dot flex items-center justify-center p-2"
            data-dot={index}
            aria-label={`Ir a la imagen ${index + 1}`}
            aria-current={index === 0 ? "true" : undefined}
          >
            <span
              class={`block h-2.5 rounded-full transition-all duration-300 ${
                index === 0 ? "w-7 bg-white" : "w-2.5 bg-white/50 group-hover/dot:bg-white/80"
              }`}
            ></span>
          </button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  const hero = document.getElementById("hero-carousel");
  const slides = hero ? [...hero.querySelectorAll(".hero-slide")] : [];
  const dots = hero ? [...hero.querySelectorAll(".hero-dot")] : [];
  const prevBtn = document.getElementById("hero-prev");
  const nextBtn = document.getElementById("hero-next");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  // Pasa data-src/data-srcset/data-sizes a los atributos reales: desde ese
  // momento el navegador pide la foto.
  function loadSlide(slide: Element | undefined) {
    slide?.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
      const { src, srcset, sizes } = img.dataset;

      if (sizes) img.sizes = sizes;
      if (srcset) img.srcset = srcset;
      if (src) img.src = src;
      img.removeAttribute("data-src");
    });
  }

  const loadAllSlides = () => slides.forEach(loadSlide);

  if (document.readyState === "complete") loadAllSlides();
  else window.addEventListener("load", loadAllSlides, { once: true });

  function showSlide(index: number) {
    // Si el usuario se adelanta al evento load, se pide ya la que va a ver.
    loadSlide(slides[index]);

    slides.forEach((slide, i) => {
      slide.classList.toggle("opacity-100", i === index);
      slide.classList.toggle("opacity-0", i !== index);
    });

    dots.forEach((dot, i) => {
      const mark = dot.firstElementChild;

      mark?.classList.toggle("w-7", i === index);
      mark?.classList.toggle("bg-white", i === index);
      mark?.classList.toggle("w-2.5", i !== index);
      mark?.classList.toggle("bg-white/50", i !== index);

      if (i === index) dot.setAttribute("aria-current", "true");
      else dot.removeAttribute("aria-current");
    });

    current = index;
  }

  const next = () => showSlide((current + 1) % slides.length);
  const prev = () => showSlide((current - 1 + slides.length) % slides.length);

  function startAutoplay() {
    stopAutoplay();

    if (slides.length > 1 && !reduceMotion.matches) {
      timer = setInterval(next, 6000);
    }
  }

  function stopAutoplay() {
    if (timer) clearInterval(timer);
    timer = undefined;
  }

  // Cualquier interacción reinicia el temporizador para no cortar la lectura.
  function withRestart(action: () => void) {
    return () => {
      action();
      startAutoplay();
    };
  }

  prevBtn?.addEventListener("click", withRestart(prev));
  nextBtn?.addEventListener("click", withRestart(next));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", withRestart(() => showSlide(index)));
  });

  // Pausa al pasar el cursor o al enfocar con teclado.
  hero?.addEventListener("mouseenter", stopAutoplay);
  hero?.addEventListener("mouseleave", startAutoplay);
  hero?.addEventListener("focusin", stopAutoplay);
  hero?.addEventListener("focusout", startAutoplay);

  // Deslizar con el dedo en móvil.
  let touchStartX = 0;

  hero?.addEventListener(
    "touchstart",
    (event) => {
      touchStartX = event.changedTouches[0].screenX;
    },
    { passive: true }
  );

  hero?.addEventListener(
    "touchend",
    (event) => {
      const delta = event.changedTouches[0].screenX - touchStartX;

      if (Math.abs(delta) > 45) {
        if (delta < 0) next();
        else prev();
        startAutoplay();
      }
    },
    { passive: true }
  );

  // No animar mientras la pestaña está en segundo plano.
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopAutoplay();
    else startAutoplay();
  });

  reduceMotion.addEventListener("change", startAutoplay);

  startAutoplay();
</script>
