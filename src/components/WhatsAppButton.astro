---
import { contactInfo } from "../data/contactInfo";

const phone = contactInfo.whatsapp[0].replace(/\D/g, "");

const href = `https://wa.me/${phone}?text=${encodeURIComponent(
  "Hola, quisiera información sobre sus productos."
)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="group fixed bottom-4 right-4 z-[60] flex items-center sm:bottom-5 sm:right-5"
>
  <!-- Burbuja: sólo en pantallas amplias, para no tapar contenido en móvil -->
  <div
    id="wa-bubble"
    class="mr-3 hidden translate-y-2 rounded-full bg-white px-4 py-2 text-xs font-medium text-gray-800 opacity-0 shadow-lg transition-all duration-300 lg:block"
  >
    ¿Tubos?
  </div>

  <div
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-transform duration-300 group-hover:scale-110"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-7 w-7 fill-current" aria-hidden="true">
      <path d="M19.11 17.23c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.31.2-.58.07-.27-.14-1.13-.41-2.15-1.31-.79-.7-1.33-1.56-1.48-1.82-.16-.27-.02-.41.12-.55.12-.12.27-.31.41-.47.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.47-.07-.14-.61-1.47-.84-2.02-.22-.53-.44-.46-.61-.47h-.52c-.18 0-.47.07-.72.34s-.95.93-.95 2.27.97 2.63 1.11 2.81c.14.18 1.9 2.9 4.6 4.06.64.27 1.13.43 1.52.55.64.2 1.22.17 1.68.1.51-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32z"/>
      <path d="M16.03 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.26.59 4.46 1.7 6.39L3.2 28.8l6.58-1.69a12.76 12.76 0 0 0 6.25 1.61h.01c7.07 0 12.8-5.73 12.8-12.8S23.1 3.2 16.03 3.2zm0 23.4h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.9 1 1.04-3.8-.25-.39a10.58 10.58 0 1 1 8.91 4.9z"/>
    </svg>
  </div>
</a>

<script>
  const bubble = document.getElementById("wa-bubble");

  // El mensaje rota unas pocas veces y luego se detiene: llama la atención
  // sin convertirse en una animación permanente que distraiga al leer.
  if (bubble && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const messages = ["¿Tubos?", "¿Accesorios?", "¿Cotización?", "Escríbenos"];

    let index = 0;

    const show = (text: string) => {
      bubble.textContent = text;
      bubble.classList.remove("opacity-0", "translate-y-2");
      bubble.classList.add("opacity-100", "translate-y-0");
    };

    const hide = () => {
      bubble.classList.remove("opacity-100", "translate-y-0");
      bubble.classList.add("opacity-0", "translate-y-2");
    };

    const timer = setInterval(() => {
      if (index >= messages.length) {
        clearInterval(timer);
        hide();
        return;
      }

      show(messages[index]);
      index += 1;

      setTimeout(hide, 2600);
    }, 4200);
  }
</script>
