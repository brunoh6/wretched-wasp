---
import { Image } from "astro:assets";

const {
  title,
  description,
  /** Foto importada de src/assets (sale en WebP) o ruta de texto de public/. */
  image,
  href
} = Astro.props;

const Tag = href ? "a" : "div";
const imageClass =
  "img-bright h-60 w-full object-cover transition-transform duration-500 group-hover:scale-105 sm:h-72";
---

<Tag
  href={href}
  class="group relative block overflow-hidden rounded-xl shadow-lg transition hover:shadow-xl"
>
  {typeof image === "string" ? (
    <img src={image} alt={title} loading="lazy" class={imageClass} />
  ) : (
    <Image
      src={image}
      alt={title}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
      class={imageClass}
    />
  )}

  <!-- Degradado sólo en la mitad inferior: la foto se ve, el texto se lee. -->
  <div
    class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/85 via-black/45 to-transparent p-5 sm:p-6"
  >
    <h3 class="text-lg font-semibold text-white sm:text-xl">
      {title}
    </h3>

    <p class="mt-1.5 text-sm leading-relaxed text-gray-200">
      {description}
    </p>
  </div>
</Tag>
