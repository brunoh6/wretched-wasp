---
import { IMAGE_PLACEHOLDER_ICON } from "../data/imagePlaceholder";
import type { ServiceImage } from "../data/services";

interface Props {
  title: string;
  description: string;
  /** null = foto pendiente: sale el marcador "Imagen próximamente". */
  image: ServiceImage | null;
  href?: string;
}

const { title, description, image, href } = Astro.props;

const Tag = href ? "a" : "div";
const imageClass =
  "h-60 w-full object-cover transition-transform duration-500 group-hover:scale-105 sm:h-72";
---

<Tag
  href={href}
  class="group relative block overflow-hidden rounded-xl shadow-lg transition hover:shadow-xl"
>
  {image ? (
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={title}
      loading="lazy"
      decoding="async"
      class:list={["img-bright", imageClass]}
    />
  ) : (
    <img src={IMAGE_PLACEHOLDER_ICON} width="640" height="400" alt="" class:list={["bg-gray-50", imageClass]} />
  )}

  <!-- Degradado sólo en la mitad inferior: la foto se ve, el texto se lee.
       wrap-anywhere: un texto del panel sin espacios (una URL) no desborda. -->
  <div
    class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/85 via-black/45 to-transparent p-5 sm:p-6"
  >
    <h3 class="text-lg font-semibold text-white wrap-anywhere sm:text-xl">
      {title}
    </h3>

    <p class="mt-1.5 text-sm leading-relaxed text-gray-200 wrap-anywhere">
      {description}
    </p>
  </div>
</Tag>
