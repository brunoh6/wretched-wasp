---
const {
  title,
  subtitle,
  id,
  /** `tight` reduce aún más el espaciado para bloques encadenados. */
  tight = false,
  class: className = ""
} = Astro.props;

// Ritmo vertical escalonado: compacto en móvil, holgado en escritorio.
const spacing = tight ? "py-10 md:py-12" : "py-14 md:py-20";
---

<section id={id} class={`${spacing} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {(title || subtitle) && (
      <div class="mb-8 max-w-2xl md:mb-10">
        {title && (
          <h2 class="text-2xl font-bold sm:text-3xl">
            {title}
          </h2>
        )}

        {subtitle && (
          <p class="mt-3 text-gray-600">
            {subtitle}
          </p>
        )}
      </div>
    )}

    <slot />
  </div>
</section>
