---
import { IMAGE_PLACEHOLDER } from "../data/imagePlaceholder";
import type { ServiceImage } from "../data/services";

interface Props {
  title: string;
  /** Texto plano del panel: Astro lo escapa, así que no admite HTML. */
  paragraphs: string[];
  /** null = foto pendiente: sale el marcador "Imagen próximamente". */
  image: ServiceImage | null;
  /** Enlace "Quiero hablar con un especialista →" (WhatsApp). */
  contactHref?: string;
  reverse?: boolean;
}

const { title, paragraphs, image, contactHref, reverse = false } = Astro.props;

const imageClass = "max-h-[400px] w-full rounded-xl object-contain";
---

<section class="py-12 md:py-16">
  <div
    class:list={[
      "mx-auto grid max-w-7xl items-center gap-8 px-4 sm:px-6 md:gap-12",
      reverse ? "md:grid-cols-[1fr_1.15fr]" : "md:grid-cols-[1.15fr_1fr]"
    ]}
  >
    <div class:list={["relative", reverse && "md:order-2"]}>
      {image ? (
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={title}
          loading="lazy"
          decoding="async"
          data-fallback-image
          class:list={["img-bright", imageClass]}
        />
      ) : (
        <img src={IMAGE_PLACEHOLDER} width="640" height="400" alt="" class:list={["bg-gray-50", imageClass]} />
      )}
    </div>

    <!-- wrap-anywhere: un texto del panel sin espacios (una URL) se parte en
         vez de ensanchar la columna y dar scroll lateral en el celular. -->
    <div class:list={[reverse && "md:order-1"]}>
      <h2 class="text-2xl font-bold wrap-anywhere sm:text-3xl">{title}</h2>

      {paragraphs.map((paragraph, index) => (
        <p class:list={["max-w-xl leading-relaxed text-gray-700 wrap-anywhere", index === 0 ? "mt-4" : "mt-3"]}>
          {paragraph}
        </p>
      ))}

      {contactHref && (
        <p class="mt-4 leading-relaxed">
          <a
            href={contactHref}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-[#003595] hover:underline"
          >
            Quiero hablar con un especialista →
          </a>
        </p>
      )}
    </div>
  </div>
</section>

<script>
  import { IMAGE_PLACEHOLDER } from "../data/imagePlaceholder";

  // La compilación ya comprueba que la foto existe y se puede mostrar; esto
  // cubre lo que pase después (una subida a medias al servidor).
  document.querySelectorAll<HTMLImageElement>("[data-fallback-image]").forEach((img) => {
    const applyFallback = () => {
      img.src = IMAGE_PLACEHOLDER;
      img.classList.remove("img-bright");
      img.classList.add("bg-gray-50");
    };

    img.addEventListener("error", applyFallback, { once: true });

    // Cubre el caso en que la imagen ya falló antes de registrar el listener.
    if (img.complete && img.naturalWidth === 0) applyFallback();
  });
</script>
