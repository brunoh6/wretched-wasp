---
const {
  title,
  image,
  href = "#",
  subtitle = "",
  badge = ""
} = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:-translate-y-1 hover:border-[#003595]/30 hover:shadow-lg"
>
  <div class="aspect-[4/3] overflow-hidden bg-gray-50">
    <!-- alt vacío: el título ya está dentro del mismo enlace, y repetirlo hace
         que el lector de pantalla lo anuncie dos veces. -->
    <img
      src={image}
      alt=""
      loading="lazy"
      class="img-bright h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-1 flex-col p-4">
    {badge && (
      <span class="mb-2 inline-block self-start rounded-full bg-[#003595]/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-[#003595]">
        {badge}
      </span>
    )}

    <h3 class="font-semibold text-gray-900 group-hover:text-[#003595]">
      {title}
    </h3>

    {subtitle && (
      <p class="mt-1 text-sm text-gray-600">
        {subtitle}
      </p>
    )}
  </div>
</a>
