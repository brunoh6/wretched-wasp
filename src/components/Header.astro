---
import SearchBar from "./SearchBar.astro";
import { visibleCategories } from "../data/categories";
// El enlace a Certificaciones sólo se renderiza si la sección está publicada:
// mientras el flag esté en `false` la ruta no existe y un enlace daría 404.
import { CERTIFICATIONS_ENABLED } from "../data/certifications";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);

const services = [
  { href: "/servicios/#termofusion", label: "Termofusión" },
  { href: "/servicios/#electrofusion", label: "Electrofusión" },
  { href: "/servicios/#carpinteria-plastica", label: "Carpintería Plástica" },
  { href: "/servicios/#alquiler-maquinas", label: "Alquiler de máquinas" }
];
---

<header
  id="site-navbar"
  class="sticky top-0 z-50 border-b border-gray-200 bg-white transition-all duration-300"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Navegación principal"
  >

    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center" aria-label="DIHYC — Inicio">
      <img
        src="/assets/hero/logo.png"
        alt="DIHYC"
        width="120"
        height="40"
        class="h-9 w-auto md:h-10"
      />
    </a>

    <!-- ================= DESKTOP NAVIGATION ================= -->
    <div class="hidden items-center gap-6 text-sm font-medium lg:flex xl:gap-8">

      <a
        href="/empresa/"
        class:list={["nav-link", isActive("/empresa") && "nav-link-active"]}
      >
        QUIÉNES SOMOS
      </a>

      <!-- PRODUCTOS -->
      <div class="relative group">
        <a
          href="/productos/"
          class:list={["nav-link inline-flex items-center gap-1", isActive("/productos") && "nav-link-active"]}
          aria-haspopup="true"
        >
          PRODUCTOS
          <svg class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
          </svg>
        </a>

        <div class="dropdown-panel w-56">
          <div class="rounded-lg border border-gray-200 bg-white p-2 shadow-lg">
            {visibleCategories.map((category) => (
              <a
                href={`/productos/${category.slug}/`}
                class="block rounded-md px-3 py-2 text-gray-700 transition hover:bg-gray-50 hover:text-[#003595]"
              >
                {category.navLabel ?? category.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- SERVICIOS -->
      <div class="relative group">
        <a
          href="/servicios/"
          class:list={["nav-link inline-flex items-center gap-1", isActive("/servicios") && "nav-link-active"]}
          aria-haspopup="true"
        >
          SERVICIOS
          <svg class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
          </svg>
        </a>

        <div class="dropdown-panel w-60">
          <div class="rounded-lg border border-gray-200 bg-white p-2 shadow-lg">
            {services.map((service) => (
              <a
                href={service.href}
                class="block rounded-md px-3 py-2 text-gray-700 transition hover:bg-gray-50 hover:text-[#003595]"
              >
                {service.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {CERTIFICATIONS_ENABLED && (
        <a
          href="/certificaciones/"
          class:list={["nav-link", isActive("/certificaciones") && "nav-link-active"]}
        >
          CERTIFICACIONES
        </a>
      )}

      <a
        href="/contacto/"
        class="cta rounded bg-[#003595] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#002a75]"
      >
        CONTACTO
      </a>
    </div>

    <!-- ================= SEARCH + SOCIAL (desktop) ================= -->
    <div class="hidden items-center gap-4 lg:flex">
      <div class="w-44 xl:w-60">
        <SearchBar />
      </div>

      <div class="hidden items-center gap-3 xl:flex">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-gray-500 transition hover:text-[#1877F2]"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.4H15c-1.2 0-1.6.7-1.6 1.5V12H17l-.5 3h-3v7A10 10 0 0022 12z"/>
          </svg>
        </a>

        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-gray-500 transition hover:text-[#0A66C2]"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95v5.67H9.33V9h3.42v1.56h.05c.48-.9 1.66-1.86 3.42-1.86 3.66 0 4.33 2.41 4.33 5.54v6.21zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- ================= MOBILE ACTIONS ================= -->
    <div class="flex items-center gap-1 lg:hidden">
      <a
        href="/contacto/"
        class="rounded bg-[#003595] px-3 py-2 text-xs font-semibold text-white transition hover:bg-[#002a75] sm:px-4 sm:text-sm"
      >
        CONTACTO
      </a>

      <button
        id="menuToggle"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-md text-gray-700 transition hover:bg-gray-100"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="menuIconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <svg id="menuIconClose" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </nav>

  <!-- ================= MOBILE MENU ================= -->
  <div
    id="mobileMenu"
    class="hidden max-h-[calc(100dvh-4.25rem)] overflow-y-auto border-t bg-white lg:hidden"
  >
    <div class="flex flex-col gap-5 px-4 py-5 text-sm sm:px-6">

      <div class="w-full">
        <SearchBar />
      </div>

      <a
        href="/empresa/"
        class:list={["mobile-link", isActive("/empresa") && "text-[#003595]"]}
      >
        QUIÉNES SOMOS
      </a>

      <div>
        <a
          href="/productos/"
          class:list={["mobile-link", isActive("/productos") && "text-[#003595]"]}
        >
          PRODUCTOS
        </a>

        <div class="mt-1 flex flex-col">
          {visibleCategories.map((category) => (
            <a
              href={`/productos/${category.slug}/`}
              class="rounded-md py-2.5 pl-4 text-gray-600 transition hover:bg-gray-50 hover:text-[#003595]"
            >
              {(category.navLabel ?? category.name).toUpperCase()}
            </a>
          ))}
        </div>
      </div>

      <div>
        <a
          href="/servicios/"
          class:list={["mobile-link", isActive("/servicios") && "text-[#003595]"]}
        >
          SERVICIOS
        </a>

        <div class="mt-1 flex flex-col">
          {services.map((service) => (
            <a
              href={service.href}
              class="rounded-md py-2.5 pl-4 text-gray-600 transition hover:bg-gray-50 hover:text-[#003595]"
            >
              {service.label}
            </a>
          ))}
        </div>
      </div>

      {CERTIFICATIONS_ENABLED && (
        <a
          href="/certificaciones/"
          class:list={["mobile-link", isActive("/certificaciones") && "text-[#003595]"]}
        >
          CERTIFICACIONES
        </a>
      )}

      <div class="flex items-center gap-5 border-t pt-5">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-gray-500 transition hover:text-[#1877F2]"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.4H15c-1.2 0-1.6.7-1.6 1.5V12H17l-.5 3h-3v7A10 10 0 0022 12z"/>
          </svg>
        </a>

        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-gray-500 transition hover:text-[#0A66C2]"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95v5.67H9.33V9h3.42v1.56h.05c.48-.9 1.66-1.86 3.42-1.86 3.66 0 4.33 2.41 4.33 5.54v6.21zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

</header>

<style>
  .nav-link {
    position: relative;
    color: #374151;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link-active {
    color: #003595;
  }

  .nav-link-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 2px;
    border-radius: 2px;
    background-color: #003595;
  }

  .mobile-link {
    display: block;
    font-weight: 600;
    color: #111827;
  }

  /* Panel de menú desplegable: abre con hover y también con foco de teclado. */
  .dropdown-panel {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 50;
    padding-top: 0.6rem;
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
  }

  .group:hover .dropdown-panel,
  .group:focus-within .dropdown-panel {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menuToggle");
  const menu = document.getElementById("mobileMenu");
  const iconOpen = document.getElementById("menuIconOpen");
  const iconClose = document.getElementById("menuIconClose");

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;

    menu.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  }

  toggle?.addEventListener("click", () => {
    setMenu(menu?.classList.contains("hidden") ?? false);
  });

  // Cerrar al elegir un enlace (incluye anclas de la misma página).
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  // Al volver a escritorio el menú móvil debe quedar cerrado.
  const desktop = window.matchMedia("(min-width: 1024px)");
  desktop.addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });
</script>
