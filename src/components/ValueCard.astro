---
const { title, text, icon } = Astro.props;
---

<div
  class="group h-full rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg sm:p-8"
>
  {icon && (
    <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-[#003595]/10 text-2xl">
      <span aria-hidden="true">{icon}</span>
    </div>
  )}

  <h3 class="mb-2 text-lg font-semibold sm:text-xl">
    {title}
  </h3>

  <p class="text-sm leading-relaxed text-gray-700">
    {text}
  </p>
</div>
