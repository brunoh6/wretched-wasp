---
const { brands } = Astro.props;

// Duplicamos el array para el efecto de bucle: la pista se desplaza -50%,
// justo el ancho de la primera copia, y el salto resulta invisible.
const loopBrands = [...brands, ...brands];
const total = brands.length;
---

<div class="brand-carousel">
  <div class="brand-track">
    {loopBrands.map((brand, i) => (
      <div class="brand-item" aria-hidden={i >= total ? "true" : undefined}>
        <img
          src={brand.logo}
          alt={brand.name}
          loading="lazy"
          decoding="async"
          width="200"
          height="110"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .brand-carousel {
    overflow: hidden;
    width: 100%;
    /* Holgura vertical: el overflow:hidden recorta arriba/abajo y el logo
       crece un 5% al pasar el cursor; este padding evita que se corte. */
    padding-block: 0.5rem;
  }

  .brand-track {
    display: flex;
    animation: scroll 25s linear infinite;
    width: max-content;
    /*
      Sin `gap`: la separación va como margin-right de cada logo. Así cada copia
      del array mide exactamente lo mismo (item + margen) y el -50% cae en el
      punto exacto del bucle, sin el medio hueco que dejaba el gap.
      Nota: no se pausa en :hover; el usuario quiere movimiento continuo.
    */
  }

  /*
    Caja de tamaño fijo para cada logo: reserva el espacio antes de que la
    imagen cargue y evita saltos de layout (CLS) con logos de proporciones
    muy distintas (cuadrados, apaisados, etc.).
  */
  .brand-item {
    flex: 0 0 auto;
    width: 150px;
    height: 84px;
    margin-right: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /*
      Realce coherente con la utilidad global .img-bright, pero sin `saturate`
      y con brillo contenido: varios logos son PNG oscuros sobre fondo
      transparente y la sección tiene fondo claro, así que subir demasiado el
      brillo los desvanecería. El contraste extra compensa el brillo.
      No se usa invert ni se altera el color de marca.
    */
    opacity: 1;
    filter: brightness(1.08) contrast(1.04);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  /* Realce sutil al pasar el cursor: sólo afecta al logo, nunca a la animación. */
  .brand-item img:hover {
    filter: brightness(1.14) contrast(1.06);
    transform: scale(1.05);
  }

  @media (min-width: 768px) {
    .brand-item {
      width: 200px;
      height: 110px;
      margin-right: 3rem;
    }
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      width: 100%;
    }

    .brand-item {
      margin-right: 0;
    }

    /*
      Sin animación la pista se convierte en una rejilla estática, y ahí la
      copia duplicada se vería como un error: cada marca aparecería dos veces.
      Sólo existe para cerrar el bucle, así que se oculta en este modo.
    */
    .brand-item[aria-hidden="true"] {
      display: none;
    }

    .brand-item img,
    .brand-item img:hover {
      transition: none;
      transform: none;
    }
  }
</style>
