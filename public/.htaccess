# =============================================================================
# .htaccess de www.dihyc.com.pe — hosting cPanel compartido (Apache o LiteSpeed)
#
# Qué hace, en orden:
#   1. Deja pasar /.well-known/ tal cual (validación del SSL automático).
#   2. Lleva a la dirección canónica https://www.dihyc.com.pe en UN solo salto,
#      y las direcciones del sitio viejo (/productos.php…) a sus páginas nuevas.
#   3. Bloquea archivos ocultos.
#   4. Cabeceras de seguridad y Content-Security-Policy.
#   5. Caché: assets con hash un año, HTML siempre fresco, PDFs/imágenes 1 día.
#   6. Compresión, página 404 propia y sin listado de carpetas.
#
# POR QUÉ TODO VA ACOTADO AL HOST (www.)dihyc.com.pe
#   En este hosting hay además un dominio complementario. Si su carpeta vive
#   DENTRO de public_html, Apache le aplica también este archivo. Acotando cada
#   regla al host, ese otro sitio no recibe nuestras redirecciones ni nuestras
#   cabeceras. Nunca escribir reglas del tipo "cualquier host que no sea www".
#
# POR QUÉ TODO VA DENTRO DE <IfModule>
#   En un hosting compartido no controlamos qué módulos están activos. Una
#   directiva de un módulo ausente da error 500 en TODO el sitio; dentro de
#   <IfModule> simplemente se ignora. (Probado: ver README-deploy.md.)
#
# No se usan <If>/<ElseIf>: LiteSpeed, que muchos cPanel usan en vez de Apache,
# no los soporta bien. Si tras publicar el sitio entero da error 500, la primera
# sospechosa es "Options -Indexes" (algunos proveedores no permiten Options en
# .htaccess): comentarla y volver a probar.
# =============================================================================

# ── Básicos ──────────────────────────────────────────────────────────────────
# Sin listado de carpetas: /assets/fichas-tecnicas/ no debe mostrar un índice.
Options -Indexes
# index.html primero: en public_html sigue el index.php del sitio viejo (la
# publicación por FTP no borra lo que no subió). index.php en segundo lugar
# porque esta directiva la heredan TODAS las subcarpetas: sin él, cualquier
# carpeta PHP (la del sitio viejo, o la de otro dominio alojado dentro de
# public_html) daría 403. Además, durante la primera subida la portada vieja
# sigue respondiendo hasta que llega el index.html nuevo.
DirectoryIndex index.html index.php
# Astro genera /404.html; sin esta línea el visitante ve el error genérico.
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  # El panel /admin lee config.yml: que llegue como texto UTF-8, no como binario.
  AddType text/yaml .yml .yaml
  AddCharset UTF-8 .yml .yaml .txt .xml .json .css .js .svg
</IfModule>

# ── Redirecciones y marcas ───────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) /.well-known/ sale tal cual y NO se redirige. El SSL automático de cPanel
  #    (AutoSSL: Let's Encrypt o Sectigo) valida el dominio por HTTP plano en
  #    esta carpeta; si se redirigiera, la renovación del certificado fallaría.
  RewriteRule ^\.well-known/ - [L]

  # 2) Dirección canónica en UN solo salto: http→https y sin-www→www a la vez.
  #    HTTPS se detecta también por X-Forwarded-Proto para no crear un bucle si
  #    algún día el sitio queda detrás de un proxy (por ejemplo Cloudflare).
  #    La query (?linea=fm) se conserva sola: la sustitución no lleva "?".
  RewriteCond %{HTTP_HOST} ^(www\.)?dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.dihyc.com.pe%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.dihyc.com.pe%{REQUEST_URI} [R=301,L]

  # 2b) Direcciones del sitio viejo (PHP) → sus páginas nuevas. Sus archivos
  #     siguen en el servidor: sin esto /productos.php mostraría el catálogo
  #     viejo, y Google conserva esas direcciones. Se mira THE_REQUEST (lo que
  #     pidió el navegador), no la ruta interna: así "/" servido por el
  #     index.php viejo (ver DirectoryIndex) no entra en un bucle. El "?" final
  #     descarta la query vieja, que el sitio nuevo no entiende. Las direcciones
  #     viejas sin extensión (/productos) ya son carpetas del sitio nuevo.
  RewriteCond %{HTTP_HOST} ^www\.dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(index\.php|indexw\.html)[\s?]
  RewriteRule ^ https://www.dihyc.com.pe/? [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(productos|empresa|servicios|contacto)\.php[\s?]
  RewriteRule ^ https://www.dihyc.com.pe/%1/? [R=301,L]

  # 3) Archivos ocultos (nombre que empieza por punto) prohibidos. Ejemplo real:
  #    la publicación por FTP deja .ftp-deploy-sync-state.json con la lista de
  #    archivos del sitio, que no tiene por qué ser pública. (.well-known ya salió
  #    en la regla 1, así que no la afecta.)
  RewriteCond %{HTTP_HOST} ^(www\.)?dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteRule (^|/)\. - [F]

  # 4) Marcas para las cabeceras de más abajo. "Header ... env=" admite una sola
  #    condición, así que aquí se combinan host + protocolo/ruta en una variable.
  #
  #    HSTS sólo en respuestas HTTPS de nuestro dominio.
  RewriteCond %{HTTP_HOST} ^www\.dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^ - [E=DIHYC_HSTS:1]

  #    /_astro/ guarda archivos con un hash en el nombre: si cambian, cambia el
  #    nombre. Por eso pueden quedarse en caché un año sin riesgo.
  RewriteCond %{HTTP_HOST} ^(www\.)?dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteRule ^_astro/ - [E=DIHYC_INMUTABLE:1]

  #    PDFs e imágenes: caché CORTA. Las fichas técnicas se reemplazan con el
  #    MISMO nombre de archivo (pasó en septiembre con 12 PDFs): una caché larga
  #    seguiría mostrando la ficha vieja durante días.
  RewriteCond %{HTTP_HOST} ^(www\.)?dihyc\.com\.pe(:[0-9]+)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/_astro/
  RewriteRule \.(pdf|jpe?g|png|webp|gif|svg|ico)$ - [E=DIHYC_CACHE_CORTA:1]
</IfModule>

# ── Cabeceras ────────────────────────────────────────────────────────────────
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^(www\.)?dihyc\.com\.pe(:[0-9]+)?$" DIHYC
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff" env=DIHYC
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=DIHYC
  Header always set X-Frame-Options "SAMEORIGIN" env=DIHYC
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" env=DIHYC

  # Content-Security-Policy hecha para ESTE sitio (verificada en navegador sin
  # violaciones en todas las páginas, ver README-deploy.md):
  #   - script-src 'unsafe-inline': Astro emite scripts en línea (is:inline) y el
  #     catálogo usa onerror= en las imágenes. Aun así la política protege contra
  #     incrustar el sitio en otro (clickjacking), plugins, <base> inyectado y
  #     formularios que envíen datos a terceros.
  #   - fonts.googleapis/gstatic: tipografía Poppins.
  #   - www.google.com: el mapa incrustado de /contacto.
  #   - formspree.io: el formulario de contacto.
  # Si se añade Google Analytics, sumar sus dominios a script-src y connect-src.
  # /admin tiene su propia política en admin/.htaccess (el CMS la necesita).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com; connect-src 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" env=DIHYC

  # HSTS prudente: 1 día, SIN includeSubDomains ni preload. Con includeSubDomains,
  # cualquier subdominio sin SSL (correo, el subdominio que ya existe) quedaría
  # inaccesible en los navegadores. Tras un mes sin incidencias se puede subir a
  # max-age=31536000 (un año), siempre sin includeSubDomains salvo que TODOS los
  # subdominios tengan HTTPS.
  Header always set Strict-Transport-Security "max-age=86400" env=DIHYC_HSTS

  # Caché
  Header set Cache-Control "public, max-age=31536000, immutable" env=DIHYC_INMUTABLE
  Header set Cache-Control "public, max-age=86400" env=DIHYC_CACHE_CORTA
  # HTML, sitemap, robots y config del CMS: el navegador revalida en cada visita,
  # así un cambio hecho desde el panel se ve al instante.
  <FilesMatch "\.(html?|xml|txt|ya?ml|json)$">
    Header set Cache-Control "no-cache" env=DIHYC
  </FilesMatch>
</IfModule>

# ── Compresión ───────────────────────────────────────────────────────────────
# AddOutputFilterByType pertenece a mod_filter en Apache 2.4: si mod_deflate
# estuviera activo y mod_filter no, la directiva daría 500. De ahí el doble
# <IfModule>.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/yaml application/xml application/javascript text/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
