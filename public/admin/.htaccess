# =============================================================================
# Panel de administración (/admin) — política propia.
#
# La Content-Security-Policy del sitio bloquearía el CMS: Sveltia se carga desde
# unpkg.com y habla con la API de GitHub. En vez de listar cada dominio que el
# CMS pueda usar (cambian entre versiones y un olvido deja al cliente sin panel),
# aquí sólo se restringe lo que NO puede romperlo y más importa en un panel:
#   - frame-ancestors 'none' / X-Frame-Options DENY: nadie puede meter el panel
#     en un iframe ajeno para engañar al usuario y hacerle pulsar botones
#     (clickjacking).
#   - object-src 'none' y base-uri 'self': sin plugins ni <base> inyectado.
#
# Estas directivas se aplican DESPUÉS de las del .htaccess raíz, así que en
# /admin reemplazan a la CSP y al X-Frame-Options del sitio.
# =============================================================================

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" env=DIHYC
  Header always set X-Frame-Options "DENY" env=DIHYC
  # El panel siempre debe cargar su config.yml más reciente.
  Header set Cache-Control "no-cache" env=DIHYC
</IfModule>
